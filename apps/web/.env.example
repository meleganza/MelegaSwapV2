NEXT_PUBLIC_NODE_REAL_API_ETH=
NEXT_PUBLIC_NODE_REAL_API_GOERLI=
NEXT_PUBLIC_NODE_PRODUCTION=
# Pools UX screenshot fixture — local/dev only; set to 1 for R713 live-card captures
NEXT_PUBLIC_POOLS_UX_FIXTURE=0
# Treasury Runtime — OBSOLETE / DECOMMISSIONED (unused; safe to remove from Vercel)
# TREASURY_RUNTIME_URL=
# NEXT_PUBLIC_TREASURY_RUNTIME_URL=
# Mainnet fee beneficiary is MELEGA TREASURY WALLET via dexEconomicAuthority (not env).
# Optional testnet collector override only — mainnet divergent values are ignored.
NEXT_PUBLIC_TREASURY_COLLECTOR_BSC=
NEXT_PUBLIC_TREASURY_COLLECTOR_BSC_TESTNET=
NEXT_PUBLIC_TREASURY_COLLECTOR_ETH=
NEXT_PUBLIC_TREASURY_COLLECTOR_POLYGON=
NEXT_PUBLIC_TREASURY_COLLECTOR_BASE=
# MARCO token override (fallback only — KERL/registry is canonical)
NEXT_PUBLIC_MARCO_TOKEN_BSC=
# BscScan holder count — server-side preferred (Trade/Projects holder metrics)
BSCSCAN_API_KEY=
# Legacy browser key — migrate to BSCSCAN_API_KEY
NEXT_PUBLIC_BSCSCAN_API_KEY=
# Deprecated typo alias — rename to BSCSCAN_API_KEY in Vercel if present
# NEXT_PUBLIC_BSCSAN_API_KEY=
# Melega-native subgraph — optional when durable BSC indexer is configured
NEXT_PUBLIC_MELEGA_SUBGRAPH_URL=
# BSC durable indexer — dedicated RPC + Vercel Blob storage
BSC_RPC_URL=
BSC_RPC_FALLBACK_URL=
BLOB_READ_WRITE_TOKEN=
INDEXER_CRON_SECRET=
CRON_SECRET=

# MARCO Pay — public application binding + server-only signed webhook verification.
# The webhook signing credential is bound by MARCO's connection-grant exchange.
# MARCO_PAY_WEBHOOK_SECRET remains an optional override; do not place it in frontend env.
NEXT_PUBLIC_MARCO_PAY_APPLICATION=
MARCO_PAY_WEBHOOK_SECRET=
# Server-only settlement destination. Canonical name is MARCO_DEX_RECEIVING_WALLET.
# Optional alias: MARCO_TREASURY_SETTLEMENT_WALLET. Do not set both to different values.
# Never expose this on NEXT_PUBLIC_*.
MARCO_DEX_RECEIVING_WALLET=

# --- Foundry wrapper deploy (canonical list: repo root .env.example) ---
# TESTNET_DEPLOYER, MAINNET_DEPLOYER, DEPLOYER_OWNER
# BNB_TESTNET_RPC_URL, BNB_MAINNET_RPC_URL, BSCSCAN_API_KEY
# UNDERLYING_ROUTER, TREASURY_INTAKE, MARCO_TOKEN
