{
  "mission": "MELEGA_DEX_V1_PASSPORT_ZERO_REBUILD_V1",
  "domains": {
    "liquidity": {
      "definition": "AMM LP ownership (+ Liquidity Building program summary)",
      "adapter": "usePassportLiquidityPositions",
      "notIncluded": ["MasterChef stakes", "SmartChef stakes"]
    },
    "farms": {
      "definition": "MasterBuilder/MasterChef LP staking",
      "adapter": "useFarmsStakingRuntime + buildFarmsWalletPositionsViewModel",
      "notIncluded": ["AMM wallet LP without stake", "SmartChef single-token"]
    },
    "pools": {
      "definition": "SmartChef single-token staking",
      "adapter": "usePoolsStakingRuntime + buildPoolsWalletPositionsViewModel",
      "notIncluded": ["MasterChef LP farms", "AMM LP ownership"]
    }
  },
  "guard": "assertPositionDomainSeparation",
  "ui": "Local Liquidity / Farms / Pools tabs only — no global page anchors",
  "crossDomainSubstitution": false,
  "duplicateCardsAllowedOnlyWhenDistinctPositionsExist": true
}
