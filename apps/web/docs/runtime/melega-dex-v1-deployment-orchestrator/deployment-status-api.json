{
  "schema": "melega.dex.v1.deployment-orchestrator.status-api",
  "endpoint": "GET /api/deployment/status",
  "handler": "apps/web/src/pages/api/deployment/status.ts",
  "composer": "lib/deployment-orchestrator/buildOrchestratorStatus",
  "returns": [
    "globalState",
    "subsystem states",
    "readiness",
    "blockers",
    "updatedAt",
    "authority",
    "canary",
    "rollback",
    "nextAction"
  ],
  "noDuplication": true,
  "sources": [
    "assessExecutionReadiness + LB_CANONICAL_DEPLOYED_ADDRESSES",
    "getCreateTokenMachineReadableReadiness",
    "PUBLIC_FARM_FACTORY_CAPABILITY + publicFarmFactoryDeployment"
  ]
}
