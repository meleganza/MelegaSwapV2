{
  "rule": "Smart Router Fee = 25% of estimated gas fee",
  "bps": 2500,
  "sourceOfTruth": "config/constants/fee-schedule.json#services.smartRouter.fee",
  "flow": [
    "Quote",
    "Gas estimation (contract.estimateGas at confirmation)",
    "Protocol fee calculation (calculateSmartRouterGasProtocolFee)",
    "User review (preview metrics + fee transparency)",
    "Wallet signature (fee transfer + swap)",
    "Execution"
  ],
  "constraints": {
    "laterAdjustment": false,
    "refundMechanism": false,
    "overcharge": "floor division prevents rounding up"
  },
  "previewVsConfirmation": {
    "preview": "uses gasPrice + default/available gas units (220000 default)",
    "confirmation": "recomputes from live estimateGas \u2014 authoritative"
  },
  "tests": "lib/smart-swap-gas-protocol-fee/__tests__/gasProtocolFee.test.ts"
}
