    "fields": [
      "schemaVersion",
      "chainId",
      "factory",
      "factoryVersion",
      "program",
      "pair",
      "projectToken",
      "quoteAsset",
      "epochId",
      "epochStartTimestamp",
      "epochEndTimestamp",
