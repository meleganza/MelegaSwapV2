  "programAdditionalChecks": [
    "_validateBinding: program/factory/version/pair/tokens/configNonce + Factory registration + Melega getPair",
    "validateReplayAndEpoch: digest unused, epoch unused, nonce==count+1, UTC epoch identity, epoch finalized, deadline, finality depth",
    "validateAnchorAndDrift: reserve price/reduction vs intent anchors",
    "validateStrategyAndFlow: eligible flow, rate bounds, mode match, gross<=eligible*rate",
    "validateQuotePolicy: enabled quote, floors",
    "buildPlan + validateCaps: slippage/impact/budget epoch+rolling caps",
    "atomic swap → 10% fee settle → addLiquidity → accounting"
  ],
  "parameterLimits": {
    "epochDurationsSeconds": [300, 900, 1800, 3600],
    "strategyModes": ["FullAi=0", "DynamicRange=1"],
    "structuralRateBpsMax": 10000,
    "successFeeBps": 1000,
    "oneExecutionPerEpoch": true,
    "executionNonce": "must equal executionCount + 1",
    "finalityDepth": "Factory.initialFinalityDepth (15 documented)",
    "budgetCaps": "epoch remaining/total bps + rolling 24h total budget bps"
  },
  "offChainBuilder": {
    "path": "apps/web/src/lib/liquidity-building-runtime/intent-builder.ts",
    "signs": false,
