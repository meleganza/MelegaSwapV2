      "observationEndBlock",
      "anchorBlock",
      "anchorProjectReserve",
      "anchorQuoteReserve",
      "eligibleNetBuyFlow",
      "strategyMode",
      "effectiveStrategyRateBps",
      "grossQuoteTarget",
      "maximumProjectTokenIn",
