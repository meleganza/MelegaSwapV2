    "whatIsSigned": "EIP-712 digest = keccak256(0x1901 || domainSeparator || structHash). Domain: name/version/chainId/verifyingContract=program/salt=keccak256(authorizer,factory,factoryVersion). Struct: EXECUTION_INTENT_TYPEHASH + all intent fields in frozen order."
  },
  "authorizerStructuralChecks": [
    "schemaVersion match",
    "chainId == block.chainid",
    "non-zero factory/program/pair/project/quote",
    "projectToken != quoteAsset",
    "epochStart < epochEnd",
    "observationStart <= observationEnd <= anchorBlock",
    "decisionDeadline >= block.timestamp",
    "strategyMode <= 1",
