{
  "schema": "melega.dex.v1.public-farm-eligibility-engine",
  "module": "apps/web/src/views/FarmsStudio/modules/publicFarmEligibility.ts",
  "minimumTvlBnb": 0.25,
  "minimumIsCreationFee": false,
  "resultShape": [
    "status",
    "pairAddress",
    "indexed",
    "active",
    "currentTvlBnb",
    "minimumTvlBnb",
    "missingTvlBnb",
    "eligible",
    "updatedAt",
    "sourceBlock"
  ],
  "tvlFormula": "2 × WBNB reserve (human); null when pair lacks WBNB side",
  "statuses": [
    "missing_pair",
    "not_indexed",
    "inactive",
    "tvl_unavailable",
    "below_minimum_tvl",
    "eligible"
  ],
  "boundary": {
    "exactly_0_25_bnb": "eligible",
    "below_0_25_bnb": "below_minimum_tvl with missingTvlBnb = 0.25 - current"
  }
}
