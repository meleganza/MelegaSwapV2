{
  "missionId": "MELEGA_DEX_V1_AI_LIQUIDITY_BUILDER_MULTI_PROGRAM_CAPABILITY_AUDIT",
  "factoryAddress": "0xB9f3e3020141157C215902acC1fDF65e49bE4e82",
  "sources": {
    "factory": "contracts/liquidity-building/LiquidityBuildingFactoryV1.sol",
    "interface": "contracts/liquidity-building/interfaces/ILiquidityBuildingFactoryV1.sol",
    "program": "contracts/liquidity-building/LiquidityBuildingProgramV1.sol",
    "frontendAbi": "apps/web/src/views/LiquidityStudio/liquidityBuilding/abi/fragments.ts"
  },
  "factoryMethods": {
    "write": [
      {
        "name": "createProgram",
        "signature": "createProgram(address projectToken, address quoteAsset, address pair, StrategyConfig strategy, uint32 epochDurationSeconds) returns (address program, bytes32 programId)",
        "role": "Clone + initialize program; bind _activeByBaseKey; emit ProgramCreated"
      },
      {
        "name": "clearActiveIfStopped",
        "signature": "clearActiveIfStopped(address program)",
        "role": "Registry hygiene when lifecycle is Stopped"
      }
    ],
    "read": [
      {
        "name": "activeProgram",
        "signature": "activeProgram(address owner, address projectToken, address quoteAsset, address pair) view returns (address)",
        "role": "Single-slot lookup for baseKey; returns address(0) if missing or Stopped"
      },
      {
        "name": "programCount",
        "signature": "programCount() view returns (uint256)",
        "role": "Global registry length (all owners)"
      },
      {
        "name": "programAt",
        "signature": "programAt(uint256 index) view returns (address)",
        "role": "Global enumeration — not owner-filtered"
      },
      {
        "name": "getProgram",
        "signature": "getProgram(bytes32 programId) view returns (address)"
      },
      {
        "name": "programIdOf",
        "signature": "programIdOf(address program) view returns (bytes32)"
      },
      {
        "name": "isRegisteredProgram",
        "signature": "isRegisteredProgram(address program) view returns (bool)"
      },
      {
        "name": "generationCount",
        "signature": "generationCount(address owner, address projectToken, address quoteAsset, address pair) view returns (uint64)"
      },
      {
        "name": "computeBaseKey",
        "signature": "computeBaseKey(address owner, address projectToken, address quoteAsset, address pair) pure returns (bytes32)"
      },
      {
        "name": "computeProgramId",
        "signature": "computeProgramId(bytes32 baseKey, uint64 generation) view returns (bytes32)"
      },
      {
        "name": "predictProgramAddress",
        "signature": "predictProgramAddress(bytes32 programId) view returns (address)"
      },
      {
        "name": "isQuoteEnabled",
        "signature": "isQuoteEnabled(address quoteAsset) view returns (bool)"
      },
      {
        "name": "quotePolicy",
        "signature": "quotePolicy(address quoteAsset) view returns (QuoteAssetPolicy)"
      }
    ],
    "events": [
      {
        "name": "ProgramCreated",
        "indexed": ["programId", "owner", "program"],
        "fields": ["projectToken", "quoteAsset", "pair", "generation", "factoryVersion"],
        "indexingNote": "owner is indexed — preferred source for per-wallet inventory"
      }
    ],
    "notPresent": [
      "programsByOwner",
      "listPrograms",
      "activeProgramsForOwner",
      "programsByToken"
    ]
  },
  "storageModel": {
    "_quotePolicies": { "key": "quoteAsset", "value": "QuoteAssetPolicy" },
    "_programs": { "type": "address[]", "scope": "global append-only registry" },
    "_programById": { "key": "programId", "value": "program address" },
    "_idByProgram": { "key": "program address", "value": "programId" },
    "_activeByBaseKey": {
      "key": "baseKey = keccak256(owner, projectToken, quoteAsset, pair)",
      "value": "current non-replaced program address for that slot"
    },
    "_generationByBaseKey": {
      "key": "baseKey",
      "value": "uint64 generation counter"
    }
  },
  "uniqueness": {
    "rule": "At most one non-Stopped program per baseKey",
    "revert": "DuplicateActiveProgram",
    "recreate": "Allowed after Stopped; generation increments; new deterministic clone address"
  },
  "lifecycle": {
    "enum": {
      "0": "Created",
      "1": "Ready",
      "2": "Active",
      "3": "Paused",
      "4": "SafetyPaused",
      "5": "Stopped"
    },
    "transitions": [
      "Created → Ready via depositBudget",
      "Ready → Active via activate",
      "Active ↔ Paused via pause/resume",
      "→ SafetyPaused via safety path",
      "→ Stopped via stop (terminal)"
    ],
    "missionTermGaps": {
      "completed": "No dedicated Completed lifecycle — depleted reserve is a balance condition, not a lifecycle enum value",
      "terminated": "Maps to Stopped"
    }
  },
  "multiProgramMatrix": {
    "ownerA_MARCO_WBNB_and_ownerA_MM72_WBNB": "ALLOWED",
    "ownerA_MARCO_WBNB_and_ownerA_MARCO_USDT": "ALLOWED_IF_USDT_ENABLED_AND_PAIR_EXISTS",
    "ownerA_MARCO_WBNB_and_ownerA_MARCO_WBNB_second": "BLOCKED_UNTIL_FIRST_STOPPED",
    "ownerA_EYED_USDC": "ALLOWED_IF_USDC_ENABLED_AND_PAIR_EXISTS"
  },
  "contractArchitectureChangeRequired": false
}
