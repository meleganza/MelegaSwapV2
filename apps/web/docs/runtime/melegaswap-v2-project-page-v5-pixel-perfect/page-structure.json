{
  "mission": "MELEGASWAP_V2_PROJECT_PAGE_V5_PIXEL_PERFECT_REBUILD",
  "mount": "pages/project-hq/[slug].tsx → ProjectPageV5Shell",
  "aliases": ["/@:slug → /project-hq/:slug", "/project-hq/:slug"],
  "primaryFlowOrder": [
    "project-v5-hero",
    "project-v5-market",
    "project-v5-economy",
    "project-v5-boost",
    "project-v5-claim-strip (unclaimed only)",
    "project-v5-about",
    "project-v5-transparency",
    "project-v5-related",
    "app-shell-footer"
  ],
  "hero": {
    "columns": "0.39fr / 0.61fr",
    "maxHeightDesktopPx": 560,
    "left": ["logo", "name", "symbol", "badges", "desc≤3", "socials", "contract", "Buy/AddWallet/Claim"],
    "right": {
      "workspace": "project-v5-trade-workspace",
      "chart": "~60%",
      "smartSwap": "~40%",
      "realComponents": ["ProjectCharts hero", "ProjectTradingEmbed hero"]
    }
  },
  "marketStrip": {
    "maxMetrics": 8,
    "labels": ["Price", "24h", "Liquidity", "Volume 24h", "Market Cap", "FDV", "Holders", "Transactions"],
    "uncertified": "—"
  },
  "economyCards": ["Liquidity", "Farms", "Pools"],
  "boost": {
    "layout": "3x2 compact tiles",
    "services": ["featured", "trend-boost", "liquidity", "create-farm", "create-pool", "claim-project"]
  },
  "transparency": { "default": "collapsed", "label": "Technical Transparency" },
  "related": { "maxCards": 4 }
}
